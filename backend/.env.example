# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-v3-your-api-key-here

# Deepgram API (for voice transcription)
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# ─── LLM Provider Configuration ────────────────────────────────────
# Per-role provider selection: "claude" or "ollama"
# Tutor defaults to Claude (fast, interactive). Language agent defaults to Ollama (async, latency-tolerant).
# Qwen 9b on Railway CPU is too slow (~2min) for interactive tutoring — use Claude for tutor.
TUTOR_PROVIDER=claude
LANGUAGE_PROVIDER=ollama

# Ollama configuration (only needed if using ollama for any role)
OLLAMA_URL=http://ollama.railway.internal:11434
OLLAMA_TUTOR_MODEL=qwen3.5:9b
OLLAMA_LANGUAGE_MODEL=qwen3.5:4b

# Environment
NODE_ENV=development
RAILWAY_ENV=development
